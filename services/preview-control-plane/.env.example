# Copy to .env only on the deployment host. Never commit real values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_BASE_URL=https://preview-control.example.com

# Unpadded base64url values. Generate each from at least 32 random bytes.
PREVIEW_LEASE_SIGNING_KEY=replace-with-32-random-bytes
PREVIEW_ACCESS_CODE_PEPPER=replace-with-32-random-bytes
PREVIEW_ARTIFACT_URL_KEY=replace-with-32-random-bytes

# At least 32 random characters. Used only by operator/admin endpoints.
PREVIEW_ADMIN_TOKEN=replace-with-a-long-random-admin-token
