{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moke",
  "identifier": "org.houheya.moke",
  "build": {
    "beforeDevCommand": "node scripts/prepare-ohos.mjs && node scripts/dev.mjs",
    "frontendDist": "../out",
    "beforeBuildCommand": "pnpm build && pnpm build:reader && pnpm copy:reader && node scripts/prepare-ohos.mjs"
  },
  "app": {
    "security": {
      "capabilities": ["ohos"]
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": null
  }
}
