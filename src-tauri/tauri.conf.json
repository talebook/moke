{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Moke",
  "version": "../package.json",
  "identifier": "org.houheya.moke",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/dev.mjs",
    "beforeBuildCommand": "pnpm build && pnpm build:reader && pnpm copy:reader"
  },
  "app": {
    "windows": [
      {
        "title": "Moke",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**",
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$TEMP/**/*",
            "**/Readest/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "developmentTeam": "6X9BLAS47C"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwQkJFQTlFQzIyQzQ5OEMKUldTTVNTekNudXE3RU1MVERSWHNFZ3U2Q2RWa2psN1hIbTF2Z0Q0aWRWNmFhSVM5b01oNkg4dGIK",
      "endpoints": [
        "https://github.com/talebook/moke/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}