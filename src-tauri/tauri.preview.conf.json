{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Moke Preview",
  "identifier": "org.houheya.moke.preview",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs --env .env.preview",
    "beforeBuildCommand": "pnpm build:preview && pnpm build:reader && pnpm copy:reader"
  },
  "app": {
    "windows": [
      {
        "label": "preview-bootstrap",
        "title": "墨客 Preview",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "preview-bootstrap",
        "preview-default",
        "reader",
        "reader-mobile",
        "reader-android-navigation"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "windows": {
      "wix": {
        "upgradeCode": "b9d4a1f6-6c2e-4b88-9f73-47c4dd0b2a11"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
