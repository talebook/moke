{
  "$schema": "../gen/schemas/open-harmony-schema.json",
  "identifier": "ohos",
  "description": "OpenHarmony capabilities: storage, network, sync and host IPC.",
  "windows": [
    "main"
  ],
  "platforms": [
    "openHarmony"
  ],
  "remote": {
    "urls": [
      "http://*:3000/**",
      "https://*:3000/**",
      "http://*:3001/**",
      "https://*:3001/**"
    ]
  },
  "permissions": [
    "core:default",
    "fs:default",
    "os:default",
    "shell:default",
    "opener:default",
    "deep-link:default",
    "websocket:default",
    "process:default",
    "process:allow-exit",
    "process:allow-restart",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "device-info:default",
    "turso:default",
    "native-tts:default",
    "native-bridge:default",
    "log:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "core:path:allow-resolve-directory",
    "fs:read-meta",
    "fs:allow-open",
    "fs:allow-seek",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-fstat",
    "fs:allow-lstat",
    {
      "identifier": "fs:allow-read",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    {
      "identifier": "fs:scope-appdata-recursive",
      "allow": [
        {
          "path": "$APPDATA/**/*"
        }
      ]
    },
    {
      "identifier": "fs:scope-appconfig-recursive",
      "allow": [
        {
          "path": "$APPCONFIG/**/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*/**"
        },
        {
          "url": "https://*/**"
        },
        {
          "url": "http://*:*/**"
        },
        {
          "url": "https://*:*/**"
        }
      ]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        }
      ]
    },
    "allow-start-server",
    "allow-download-file",
    "allow-upload-file",
    "allow-get-executable-dir",
    "allow-allow-paths-in-scopes",
    "allow-read-dir",
    "allow-parse-epub-metadata",
    "allow-extract-epub-cover-full",
    "allow-parse-epub-full",
    "allow-parse-mobi-metadata",
    "allow-extract-mobi-cover-full",
    "allow-update-book-presence",
    "allow-clear-book-presence",
    "allow-clip-url",
    "allow-localsend-start",
    "allow-localsend-stop",
    "allow-localsend-get-status",
    "allow-localsend-list-devices",
    "allow-localsend-announce",
    "allow-localsend-respond",
    "allow-localsend-cancel-receive",
    "allow-localsend-send-files",
    "allow-localsend-cancel-send",
    "allow-ext-reader-event",
    "allow-moke-runtime-platform",
    "allow-moke-navigate",
    "allow-moke-record-downloaded-book",
    "allow-moke-delete-downloaded-book-file",
    "allow-moke-open-downloaded-book",
    "allow-moke-remove-downloaded-book",
    "allow-moke-reset-download-directory",
    "allow-moke-get-download-directory",
    "allow-moke-download-storage-stats",
    "allow-moke-list-downloaded-books"
  ]
}
