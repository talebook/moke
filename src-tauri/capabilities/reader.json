{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Readest top-level UI capabilities. Publication content stays in Foliate sandbox frames; path widening reuses only host-authorized fs scope.",
  "windows": [
    "reader-*",
    "moke-home-*"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPCONFIG"
        },
        {
          "path": "$APPCACHE"
        }
      ]
    },
    {
      "identifier": "fs:read-files",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPDATA/Readest"
        },
        {
          "path": "$APPDATA/Readest/**"
        },
        {
          "path": "$APPCONFIG/settings.json"
        },
        {
          "path": "$APPCONFIG/settings.json.bak"
        },
        {
          "path": "$APPCONFIG/feeds.json"
        },
        {
          "path": "$APPCONFIG/feeds.json.bak"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$TEMP/shared"
        },
        {
          "path": "$TEMP/shared/**"
        }
      ]
    },
    {
      "identifier": "fs:read-dirs",
      "allow": [
        {
          "path": "$APPCONFIG"
        },
        {
          "path": "$APPCACHE"
        },
        {
          "path": "$APPDATA/books"
        },
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPDATA/Readest"
        },
        {
          "path": "$APPDATA/Readest/**"
        },
        {
          "path": "$APPCONFIG/settings.json"
        },
        {
          "path": "$APPCONFIG/settings.json.bak"
        },
        {
          "path": "$APPCONFIG/feeds.json"
        },
        {
          "path": "$APPCONFIG/feeds.json.bak"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$TEMP/shared"
        },
        {
          "path": "$TEMP/shared/**"
        }
      ]
    },
    {
      "identifier": "fs:write-all",
      "allow": [
        {
          "path": "$APPDATA/Readest"
        },
        {
          "path": "$APPDATA/Readest/**"
        },
        {
          "path": "$APPCONFIG/settings.json"
        },
        {
          "path": "$APPCONFIG/settings.json.bak"
        },
        {
          "path": "$APPCONFIG/feeds.json"
        },
        {
          "path": "$APPCONFIG/feeds.json.bak"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$TEMP/shared"
        },
        {
          "path": "$TEMP/shared/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**:**"
        },
        {
          "url": "https://**:**"
        }
      ]
    },
    "dialog:default",
    "websocket:default",
    "os:default",
    "opener:default",
    "process:allow-exit",
    "process:allow-restart",
    "deep-link:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "clipboard-manager:allow-write-text",
    "device-info:default",
    "turso:default",
    "native-tts:default",
    "native-bridge:default",
    "log:default",
    "updater:default",
    "allow-start-server",
    "allow-download-file",
    "allow-upload-file",
    "allow-get-executable-dir",
    "allow-allow-paths-in-scopes",
    "allow-read-dir",
    "allow-parse-epub-metadata",
    "allow-extract-epub-cover-full",
    "allow-parse-epub-full",
    "allow-parse-mobi-metadata",
    "allow-extract-mobi-cover-full",
    "allow-update-book-presence",
    "allow-clear-book-presence",
    "allow-clip-url",
    "allow-localsend-start",
    "allow-localsend-stop",
    "allow-localsend-get-status",
    "allow-localsend-list-devices",
    "allow-localsend-announce",
    "allow-localsend-respond",
    "allow-localsend-cancel-receive",
    "allow-localsend-send-files",
    "allow-localsend-cancel-send",
    "allow-ext-reader-event"
  ]
}
