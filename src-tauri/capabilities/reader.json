{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Readest capabilities for dedicated reader and reader-home windows.",
  "windows": [
    "reader-*",
    "moke-home-*"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "fs:create-app-specific-dirs",
    {
      "identifier": "fs:read-files",
      "allow": [
        { "path": "$APPDATA/books/**" },
        { "path": "$APPDATA/Readest" },
        { "path": "$APPDATA/Readest/**" },
        { "path": "$APPCONFIG/settings.json" },
        { "path": "$APPCONFIG/settings.json.bak" },
        { "path": "$APPCONFIG/feeds.json" },
        { "path": "$APPCONFIG/feeds.json.bak" },
        { "path": "$APPCACHE/**" },
        { "path": "$TEMP/shared" },
        { "path": "$TEMP/shared/**" }
      ]
    },
    {
      "identifier": "fs:read-dirs",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCACHE" },
        { "path": "$APPDATA/books" },
        { "path": "$APPDATA/books/**" },
        { "path": "$APPDATA/Readest" },
        { "path": "$APPDATA/Readest/**" },
        { "path": "$APPCONFIG/settings.json" },
        { "path": "$APPCONFIG/settings.json.bak" },
        { "path": "$APPCONFIG/feeds.json" },
        { "path": "$APPCONFIG/feeds.json.bak" },
        { "path": "$APPCACHE/**" },
        { "path": "$TEMP/shared" },
        { "path": "$TEMP/shared/**" }
      ]
    },
    {
      "identifier": "fs:write-all",
      "allow": [
        { "path": "$APPDATA/Readest" },
        { "path": "$APPDATA/Readest/**" },
        { "path": "$APPCONFIG/settings.json" },
        { "path": "$APPCONFIG/settings.json.bak" },
        { "path": "$APPCONFIG/feeds.json" },
        { "path": "$APPCONFIG/feeds.json.bak" },
        { "path": "$APPCACHE/**" },
        { "path": "$TEMP/shared" },
        { "path": "$TEMP/shared/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "dialog:default",
    "websocket:default",
    "os:default",
    "opener:default",
    "process:allow-exit",
    "process:allow-restart",
    "deep-link:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "clipboard-manager:allow-write-text",
    "device-info:default",
    "turso:default",
    "native-tts:default",
    "native-bridge:default",
    "log:default",
    "updater:default"
  ]
}
