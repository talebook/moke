{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Moke host capabilities, limited to the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        },
        {
          "path": "$APPDATA/books/.servers/moke-server-storage.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/books"
        },
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        },
        {
          "path": "$APPDATA/books/.servers/moke-server-storage.json"
        }
      ]
    },
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-fstat",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        },
        {
          "path": "$APPDATA/books/.servers/moke-server-storage.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        }
      ]
    },
    "fs:allow-ftruncate",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCONFIG/server-registry"
        },
        {
          "path": "$APPCONFIG/server-registry/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**:**"
        },
        {
          "url": "https://**:**"
        }
      ]
    },
    "os:default",
    "opener:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "allow-open-reader",
    "allow-moke-runtime-platform",
    "allow-moke-connection-document",
    "allow-moke-connection-status",
    "allow-moke-connection-begin",
    "allow-moke-connection-check",
    "allow-moke-connection-dispatch",
    "allow-moke-connection-settle",
    "allow-moke-connection-commit",
    "allow-moke-connection-ack",
    "allow-moke-connection-cancel",
    "allow-moke-connection-mark-reader",
    "allow-moke-discovery-start",
    "allow-moke-discovery-snapshot",
    "allow-moke-discovery-admit",
    "allow-moke-discovery-commit",
    "allow-moke-discovery-stop",
    "allow-moke-record-downloaded-book",
    "allow-moke-delete-downloaded-book-file",
    "allow-moke-open-downloaded-book",
    "allow-moke-reveal-downloaded-book",
    "allow-moke-remove-downloaded-book",
    "allow-moke-select-download-directory",
    "allow-moke-reset-download-directory",
    "allow-moke-get-download-directory",
    "allow-moke-download-storage-stats",
    "allow-moke-list-downloaded-books",
    "allow-ext-list-extensions",
    "allow-ext-enable-extension",
    "allow-ext-disable-extension",
    "allow-ext-uninstall-extension"
  ]
}
