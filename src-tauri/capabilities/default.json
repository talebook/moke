{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Moke host capabilities, limited to the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/books"
        },
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    "fs:allow-read",
    "fs:allow-seek",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    "fs:allow-ftruncate",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**:**"
        },
        {
          "url": "https://**:**"
        }
      ]
    },
    "os:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "allow-open-reader",
    "allow-ext-list-extensions",
    "allow-ext-prepare-import",
    "allow-ext-commit-import",
    "allow-ext-cancel-import",
    "allow-ext-enable-extension",
    "allow-ext-disable-extension",
    "allow-ext-uninstall-extension",
    "allow-ext-get-api-port",
    "allow-ext-get-extensions-dir",
    "allow-ext-diagnostics"
  ]
}
