{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Moke host capabilities, limited to the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$APPDATA/books/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA/books" },
        { "path": "$APPDATA/books/**" }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        { "path": "$APPDATA/books/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "$APPDATA/books/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/books/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "os:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default"
  ]
}
